{
  "entities": {
    "LicenseRecord": {
      "title": "LicenseRecord",
      "description": "Station activation code and commercial license issued by the Super Admin.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9\\-]+$", "maxLength": 40 },
        "stationId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "stationName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "maxCollectors": { "type": "number" },
        "maxSubscribers": { "type": "number" },
        "status": { "type": "string", "enum": ["unused", "active", "suspended", "expired"] },
        "activatedByUid": { "type": "string", "maxLength": 128 },
        "activatedByEmail": { "type": "string", "maxLength": 150 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "stationId", "stationName", "maxCollectors", "maxSubscribers", "status", "expiresAt", "createdAt", "updatedAt"]
    },
    "UserRoleBinding": {
      "title": "UserRoleBinding",
      "description": "Maps an authenticated user UID to their isolated station and role.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["manager", "collector"] },
        "stationId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "stationName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "codeUsed": { "type": "string", "maxLength": 60 },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "stationId", "stationName", "codeUsed", "active", "updatedAt"]
    },
    "CollectorInvite": {
      "title": "CollectorInvite",
      "description": "Activation code issued by a Station Manager for a field collector with granular permissions.",
      "type": "object",
      "properties": {
        "inviteCode": { "type": "string", "pattern": "^[A-Z0-9\\-]+$", "maxLength": 40 },
        "stationId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "stationName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "ownerUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "collectorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 25 },
        "assignedZones": { "type": "array" },
        "permissions": { "type": "object" },
        "status": { "type": "string", "enum": ["unused", "claimed", "revoked"] },
        "claimedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteCode", "stationId", "stationName", "ownerUid", "collectorName", "phone", "assignedZones", "permissions", "status", "createdAt"]
    },
    "StationConfig": {
      "title": "StationConfig",
      "description": "Isolated commercial neighborhood electricity station configuration.",
      "type": "object",
      "properties": {
        "stationName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "kwhPriceYer": { "type": "number" },
        "minimumFeeYer": { "type": "number" },
        "mainGeneratorKwh": { "type": "number" },
        "zoneGeneratorKwh": { "type": "object" },
        "licenseCode": { "type": "string", "maxLength": 40 },
        "licenseStatus": { "type": "string", "enum": ["active", "suspended"] },
        "maxCollectors": { "type": "number" },
        "maxSubscribers": { "type": "number" },
        "ownerUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "aiPhotoVerificationEnabled": { "type": "boolean" },
        "aiPhotoVerificationSealed": { "type": "string", "maxLength": 200 },
        "aiPhotoVerificationSealedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["stationName", "kwhPriceYer", "minimumFeeYer", "mainGeneratorKwh", "licenseCode", "licenseStatus", "maxCollectors", "maxSubscribers", "ownerUid", "updatedAt"]
    },
    "CollectorProfile": {
      "title": "CollectorProfile",
      "description": "Field collector account with assigned zones and manager-controlled permissions.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "minLength": 5, "maxLength": 150 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 25 },
        "assignedZones": { "type": "array" },
        "permissions": { "type": "object" },
        "active": { "type": "boolean" },
        "inviteCode": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone", "assignedZones", "permissions", "active", "createdAt"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Electricity station subscriber meter record.",
      "type": "object",
      "properties": {
        "meterNumber": { "type": "string", "minLength": 2, "maxLength": 40 },
        "subscriberName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 25 },
        "previousReading": { "type": "number" },
        "currentReading": { "type": "number" },
        "previousDebtYer": { "type": "number" },
        "zoneStreet": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sequenceOrder": { "type": "number" },
        "assignedCollectorId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["meterNumber", "subscriberName", "phone", "previousReading", "currentReading", "previousDebtYer", "zoneStreet", "sequenceOrder", "updatedAt"]
    },
    "MeterReading": {
      "title": "MeterReading",
      "description": "Monthly field meter reading with compressed photo proof and calculated bill in YER.",
      "type": "object",
      "properties": {
        "subscriberId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "meterNumber": { "type": "string", "minLength": 2, "maxLength": 40 },
        "subscriberName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "previousReading": { "type": "number" },
        "currentReading": { "type": "number" },
        "consumptionKwh": { "type": "number" },
        "kwhPriceYer": { "type": "number" },
        "currentBillYer": { "type": "number" },
        "previousDebtYer": { "type": "number" },
        "totalDueYer": { "type": "number" },
        "photoUrl": { "type": "string", "maxLength": 0 },
        "photoSizeKb": { "type": "number" },
        "hasLocalPhoto": { "type": "boolean" },
        "aiVerificationStatus": { "type": "string", "enum": ["not_checked", "matched", "mismatch", "unreadable", "pending_offline"] },
        "aiDetectedReading": { "type": "number" },
        "aiConfidence": { "type": "number" },
        "aiVerificationReason": { "type": "string", "maxLength": 300 },
        "collectorUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "collectorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "recordedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subscriberId", "meterNumber", "subscriberName", "previousReading", "currentReading", "consumptionKwh", "kwhPriceYer", "currentBillYer", "previousDebtYer", "totalDueYer", "photoUrl", "photoSizeKb", "collectorUid", "collectorName", "recordedAt", "createdAt"]
    },
    "PaymentReceipt": {
      "title": "PaymentReceipt",
      "description": "Immediate cash payment receipt collected in the field.",
      "type": "object",
      "properties": {
        "subscriberId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "meterNumber": { "type": "string", "minLength": 2, "maxLength": 40 },
        "subscriberName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "readingId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "amountPaidYer": { "type": "number" },
        "remainingBalanceYer": { "type": "number" },
        "collectorUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "collectorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "paidAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subscriberId", "meterNumber", "subscriberName", "readingId", "amountPaidYer", "remainingBalanceYer", "collectorUid", "collectorName", "paidAt", "createdAt"]
    },
    "SubscriberPortalRecord": {
      "title": "SubscriberPortalRecord",
      "description": "Hashed subscriber lookup record for passwordless subscriber portal.",
      "type": "object",
      "properties": {
        "stationId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "stationName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "meterNumber": { "type": "string", "minLength": 2, "maxLength": 40 },
        "subscriberName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "zoneStreet": { "type": "string", "minLength": 1, "maxLength": 120 },
        "previousReading": { "type": "number" },
        "currentReading": { "type": "number" },
        "consumptionKwh": { "type": "number" },
        "currentBillYer": { "type": "number" },
        "previousDebtYer": { "type": "number" },
        "totalDueYer": { "type": "number" },
        "lastReadingPhotoUrl": { "type": "string", "maxLength": 0 },
        "lastPaymentYer": { "type": "number" },
        "readingsJson": { "type": "string", "maxLength": 150000 },
        "receiptsJson": { "type": "string", "maxLength": 150000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["stationId", "stationName", "meterNumber", "subscriberName", "zoneStreet", "previousReading", "currentReading", "consumptionKwh", "currentBillYer", "previousDebtYer", "totalDueYer", "lastReadingPhotoUrl", "lastPaymentYer", "updatedAt"]
    },
    "ManagerAlert": {
      "title": "ManagerAlert",
      "description": "Field anomaly or AI photo-reading mismatch alert reported to the station manager (text-only; meter photos remain on collector phone).",
      "type": "object",
      "properties": {
        "stationId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "subscriberId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "meterNumber": { "type": "string", "minLength": 2, "maxLength": 40 },
        "subscriberName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "collectorCode": { "type": "string", "maxLength": 60 },
        "collectorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "alertType": { "type": "string", "enum": ["photo_mismatch", "lower_reading", "high_consumption"] },
        "editedReading": { "type": "number" },
        "aiDetectedReading": { "type": "number" },
        "aiConfidence": { "type": "number" },
        "aiVerificationReason": { "type": "string", "maxLength": 300 },
        "hasLocalPhoto": { "type": "boolean" },
        "message": { "type": "string", "minLength": 2, "maxLength": 500 },
        "severity": { "type": "string", "enum": ["warning", "critical"] },
        "resolved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["stationId", "subscriberId", "meterNumber", "subscriberName", "collectorName", "message", "severity", "resolved", "createdAt"]
    },
    "DieselExpense": {
      "title": "DieselExpense",
      "description": "Diesel fuel purchase or operating expense entry for profit/loss tracking.",
      "type": "object",
      "properties": {
        "stationId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "category": { "type": "string", "enum": ["diesel", "oil", "maintenance", "salary", "other"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "liters": { "type": "number" },
        "amountYer": { "type": "number" },
        "date": { "type": "string", "maxLength": 40 },
        "createdBy": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["stationId", "category", "description", "amountYer", "date", "createdAt"]
    },
    "CollectorLocation": {
      "title": "CollectorLocation",
      "description": "Live GPS location ping reported by an active field collector.",
      "type": "object",
      "properties": {
        "collectorCode": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "collectorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "accuracyMeters": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["collectorCode", "collectorName", "lat", "lng", "updatedAt"]
    },
    "AdminVaultMeta": {
      "title": "AdminVaultMeta",
      "description": "Developer Admin encrypted/chunked backup metadata stored in Firestore.",
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["meta"] },
        "version": { "type": "number" },
        "stationIds": { "type": "array" },
        "partDocs": { "type": "array" },
        "stationsJson": { "type": "string", "maxLength": 900000 },
        "codesJson": { "type": "string", "maxLength": 900000 },
        "stationCount": { "type": "number" },
        "codeCount": { "type": "number" },
        "subscriberCount": { "type": "number" },
        "updatedByEmail": { "type": "string", "minLength": 5, "maxLength": 150 },
        "clientUpdatedAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["kind", "version", "stationIds", "partDocs", "stationsJson", "codesJson", "stationCount", "codeCount", "subscriberCount", "updatedByEmail", "clientUpdatedAt", "updatedAt"]
    },
    "AdminVaultPart": {
      "title": "AdminVaultPart",
      "description": "Chunked station backup payload document stored in Developer Admin Cloud Vault.",
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["station_part"] },
        "stationId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "partIndex": { "type": "number" },
        "totalParts": { "type": "number" },
        "payloadChunk": { "type": "string", "maxLength": 450000 },
        "updatedByEmail": { "type": "string", "minLength": 5, "maxLength": 150 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["kind", "stationId", "partIndex", "totalParts", "payloadChunk", "updatedByEmail", "updatedAt"]
    },
    "StaffVaultRecord": {
      "title": "StaffVaultRecord",
      "description": "Hashed single-document station recovery cache keyed by SHA-256 activation code hash (text/numeric data only, no meter photos).",
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["staff_vault"] },
        "stationId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "accessJson": { "type": "string", "maxLength": 10000 },
        "stationJson": { "type": "string", "maxLength": 50000 },
        "collectorsJson": { "type": "string", "maxLength": 200000 },
        "stationDataJson": { "type": "string", "maxLength": 900000 },
        "updatedByEmail": { "type": "string", "minLength": 5, "maxLength": 150 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["kind", "stationId", "accessJson", "stationJson", "collectorsJson", "stationDataJson", "updatedByEmail", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/StationConfig" },
      "description": "Super Admin role lookup collection."
    },
    "/adminVault/{docId}": {
      "schema": { "$ref": "#/entities/AdminVaultMeta" },
      "description": "Developer Admin Cloud Vault storing chunked persistent backups of stations, activation codes, and subscribers."
    },
    "/staffVault/{accessHash}": {
      "schema": { "$ref": "#/entities/StaffVaultRecord" },
      "description": "Hashed single-document station recovery cache for Managers and Collectors across devices."
    },
    "/licenses/{licenseCode}": {
      "schema": { "$ref": "#/entities/LicenseRecord" },
      "description": "Activation codes and licenses for isolated commercial stations."
    },
    "/collectorInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/CollectorInvite" },
      "description": "Manager-issued activation codes for field collectors with granular permissions."
    },
    "/userRoles/{uid}": {
      "schema": { "$ref": "#/entities/UserRoleBinding" },
      "description": "Direct user-to-station role binding."
    },
    "/stations/{stationId}": {
      "schema": { "$ref": "#/entities/StationConfig" },
      "description": "Isolated station configuration and license status."
    },
    "/stations/{stationId}/collectors/{collectorId}": {
      "schema": { "$ref": "#/entities/CollectorProfile" },
      "description": "Collectors and their manager-defined permissions under an isolated station."
    },
    "/stations/{stationId}/subscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/Subscriber" },
      "description": "Subscribers belonging strictly to this station."
    },
    "/stations/{stationId}/readings/{readingId}": {
      "schema": { "$ref": "#/entities/MeterReading" },
      "description": "Field meter readings belonging strictly to this station."
    },
    "/stations/{stationId}/receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/PaymentReceipt" },
      "description": "Payment receipts belonging strictly to this station."
    },
    "/stations/{stationId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/ManagerAlert" },
      "description": "Field anomaly and tampering alerts reported to the station manager."
    },
    "/stations/{stationId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/DieselExpense" },
      "description": "Diesel and station operating expenses."
    },
    "/stations/{stationId}/collectorLocations/{collectorCode}": {
      "schema": { "$ref": "#/entities/CollectorLocation" },
      "description": "Live GPS tracking coordinates for active collectors."
    },
    "/subscriberPortals/{lookupHash}": {
      "schema": { "$ref": "#/entities/SubscriberPortalRecord" },
      "description": "Single-document hashed lookup for subscriber portal verification."
    }
  }
}
