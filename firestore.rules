rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 40 && code.matches('^[A-Z0-9\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nabilalzuraigy@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isActiveCodeForStation(code, stationId) {
      return isValidCode(code) &&
        exists(/databases/$(database)/documents/codes/$(code)) &&
        get(/databases/$(database)/documents/codes/$(code)).data.active == true &&
        get(/databases/$(database)/documents/codes/$(code)).data.stationId == stationId;
    }

    function isActiveManagerCodeForStation(code, stationId) {
      return isActiveCodeForStation(code, stationId) &&
        get(/databases/$(database)/documents/codes/$(code)).data.role == 'manager';
    }

    function isStationActive(stationId) {
      return exists(/databases/$(database)/documents/stations/$(stationId)) &&
        get(/databases/$(database)/documents/stations/$(stationId)).data.licenseStatus == 'active';
    }

    function isStationOwner(stationId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/stations/$(stationId)) &&
        get(/databases/$(database)/documents/stations/$(stationId)).data.ownerUid == request.auth.uid;
    }

    function isStationCollector(stationId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/stations/$(stationId)/collectors/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/stations/$(stationId)/collectors/$(request.auth.uid)).data.active == true;
    }

    function collectorHasPermission(stationId, permKey) {
      return isStationCollector(stationId) &&
        get(/databases/$(database)/documents/stations/$(stationId)/collectors/$(request.auth.uid)).data.permissions[permKey] == true;
    }

    function isStationStaff(stationId) {
      return isAdmin() || isStationOwner(stationId) || isStationCollector(stationId);
    }

    function isValidPermissionsMap(perms) {
      return perms is map
        && perms.keys().hasAll(['canRecordReadings', 'canCollectCash', 'canSendInvoices', 'canViewDebts'])
        && perms.keys().hasOnly(['canRecordReadings', 'canCollectCash', 'canSendInvoices', 'canViewDebts'])
        && perms.canRecordReadings is bool
        && perms.canCollectCash is bool
        && perms.canSendInvoices is bool
        && perms.canViewDebts is bool;
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().hasOnly(['email', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 150
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidAccessCodeDoc(data) {
      return data.keys().hasAll(['code', 'role', 'stationId', 'active', 'createdBy'])
        && data.keys().hasOnly(['code', 'role', 'stationId', 'active', 'createdBy', 'name', 'phone', 'stationName', 'assignedZones', 'permissions', 'pinResetAt', 'createdAt', 'updatedAt'])
        && isValidCode(data.code)
        && data.role in ['manager', 'collector']
        && isValidId(data.stationId)
        && data.active is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 120
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('stationName' in data) || (data.stationName is string && data.stationName.size() <= 120))
        && (!('assignedZones' in data) || (data.assignedZones is list && data.assignedZones.size() <= 30))
        && (!('permissions' in data) || isValidPermissionsMap(data.permissions))
        && (!('pinResetAt' in data) || data.pinResetAt == null || (data.pinResetAt is string && data.pinResetAt.size() <= 60))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    function isValidAdminVaultMeta(data) {
      return data.keys().hasAll(['kind', 'version', 'stationIds', 'partDocs', 'stationsJson', 'codesJson', 'stationCount', 'codeCount', 'subscriberCount', 'updatedByEmail', 'clientUpdatedAt', 'updatedAt'])
        && data.keys().hasOnly(['kind', 'version', 'stationIds', 'partDocs', 'stationsJson', 'codesJson', 'stationCount', 'codeCount', 'subscriberCount', 'updatedByEmail', 'clientUpdatedAt', 'updatedAt'])
        && data.kind == 'meta'
        && data.version is number && data.version >= 1
        && data.stationIds is list && data.stationIds.size() <= 1000
        && (data.stationIds.size() == 0 || (data.stationIds[0] is string && data.stationIds[0].size() <= 128))
        && data.partDocs is list && data.partDocs.size() <= 5000
        && (data.partDocs.size() == 0 || (data.partDocs[0] is string && data.partDocs[0].size() <= 128))
        && data.stationsJson is string && data.stationsJson.size() <= 900000
        && data.codesJson is string && data.codesJson.size() <= 900000
        && data.stationCount is number && data.stationCount >= 0
        && data.codeCount is number && data.codeCount >= 0
        && data.subscriberCount is number && data.subscriberCount >= 0
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 5 && data.updatedByEmail.size() <= 150
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() <= 60
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidAdminVaultPart(data) {
      return data.keys().hasAll(['kind', 'stationId', 'partIndex', 'totalParts', 'payloadChunk', 'updatedByEmail', 'updatedAt'])
        && data.keys().hasOnly(['kind', 'stationId', 'partIndex', 'totalParts', 'payloadChunk', 'updatedByEmail', 'updatedAt'])
        && data.kind == 'station_part'
        && isValidId(data.stationId)
        && data.partIndex is number && data.partIndex >= 0
        && data.totalParts is number && data.totalParts >= 1
        && data.payloadChunk is string && data.payloadChunk.size() <= 450000
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 5 && data.updatedByEmail.size() <= 150
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidStaffVault(data) {
      return data.keys().hasAll(['kind', 'stationId', 'accessJson', 'stationJson', 'collectorsJson', 'stationDataJson', 'updatedByEmail', 'updatedAt'])
        && data.keys().hasOnly(['kind', 'stationId', 'accessJson', 'stationJson', 'collectorsJson', 'stationDataJson', 'updatedByEmail', 'updatedAt'])
        && data.kind == 'staff_vault'
        && isValidId(data.stationId)
        && data.accessJson is string && data.accessJson.size() >= 2 && data.accessJson.size() <= 10000
        && data.stationJson is string && data.stationJson.size() >= 2 && data.stationJson.size() <= 50000
        && data.collectorsJson is string && data.collectorsJson.size() >= 2 && data.collectorsJson.size() <= 200000
        && data.stationDataJson is string && data.stationDataJson.size() >= 2 && data.stationDataJson.size() <= 900000
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 5 && data.updatedByEmail.size() <= 150
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidLicense(data) {
      return data.keys().hasAll(['code', 'stationId', 'stationName', 'maxCollectors', 'maxSubscribers', 'status', 'expiresAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'stationId', 'stationName', 'maxCollectors', 'maxSubscribers', 'status', 'activatedByUid', 'activatedByEmail', 'activatedAt', 'expiresAt', 'createdAt', 'updatedAt'])
        && isValidCode(data.code)
        && isValidId(data.stationId)
        && data.stationName is string && data.stationName.size() >= 2 && data.stationName.size() <= 120
        && data.maxCollectors is number && data.maxCollectors >= 1 && data.maxCollectors <= 500
        && data.maxSubscribers is number && data.maxSubscribers >= 1 && data.maxSubscribers <= 100000
        && data.status in ['unused', 'active', 'suspended', 'expired']
        && (!('activatedByUid' in data) || (data.activatedByUid is string && data.activatedByUid.size() <= 128))
        && (!('activatedByEmail' in data) || (data.activatedByEmail is string && data.activatedByEmail.size() <= 150))
        && data.expiresAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidUserRole(data) {
      return data.keys().hasAll(['role', 'stationId', 'stationName', 'codeUsed', 'active', 'updatedAt'])
        && data.keys().hasOnly(['role', 'stationId', 'stationName', 'codeUsed', 'active', 'updatedAt'])
        && data.role in ['manager', 'collector']
        && isValidId(data.stationId)
        && data.stationName is string && data.stationName.size() >= 2 && data.stationName.size() <= 120
        && data.codeUsed is string && data.codeUsed.size() >= 4 && data.codeUsed.size() <= 60
        && data.active is bool
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidCollectorInvite(data) {
      return data.keys().hasAll(['inviteCode', 'stationId', 'stationName', 'ownerUid', 'collectorName', 'phone', 'assignedZones', 'permissions', 'status', 'createdAt'])
        && data.keys().hasOnly(['inviteCode', 'stationId', 'stationName', 'ownerUid', 'collectorName', 'phone', 'assignedZones', 'permissions', 'status', 'claimedByUid', 'claimedAt', 'createdAt'])
        && isValidCode(data.inviteCode)
        && isValidId(data.stationId)
        && data.stationName is string && data.stationName.size() >= 2 && data.stationName.size() <= 120
        && isValidId(data.ownerUid)
        && data.collectorName is string && data.collectorName.size() >= 2 && data.collectorName.size() <= 100
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 25
        && data.assignedZones is list && data.assignedZones.size() <= 20
        && (data.assignedZones.size() == 0 || (data.assignedZones[0] is string && data.assignedZones[0].size() <= 100))
        && isValidPermissionsMap(data.permissions)
        && data.status in ['unused', 'claimed', 'revoked']
        && (!('claimedByUid' in data) || (data.claimedByUid is string && data.claimedByUid.size() <= 128))
        && data.createdAt is timestamp;
    }

    function isValidStation(data) {
      return data.keys().hasAll(['stationName', 'kwhPriceYer', 'minimumFeeYer', 'mainGeneratorKwh', 'licenseCode', 'licenseStatus', 'maxCollectors', 'maxSubscribers', 'ownerUid', 'updatedAt'])
        && data.keys().hasOnly(['stationName', 'kwhPriceYer', 'minimumFeeYer', 'mainGeneratorKwh', 'zoneGeneratorKwh', 'licenseCode', 'licenseStatus', 'maxCollectors', 'maxSubscribers', 'ownerUid', 'aiPhotoVerificationEnabled', 'aiPhotoVerificationSealed', 'aiPhotoVerificationSealedAt', 'updatedAt'])
        && data.stationName is string && data.stationName.size() >= 2 && data.stationName.size() <= 120
        && data.kwhPriceYer is number && data.kwhPriceYer >= 0 && data.kwhPriceYer <= 100000
        && data.minimumFeeYer is number && data.minimumFeeYer >= 0 && data.minimumFeeYer <= 500000
        && data.mainGeneratorKwh is number && data.mainGeneratorKwh >= 0
        && (!('zoneGeneratorKwh' in data) || (data.zoneGeneratorKwh is map && data.zoneGeneratorKwh.size() <= 200))
        && isValidCode(data.licenseCode)
        && data.licenseStatus in ['active', 'suspended']
        && data.maxCollectors is number && data.maxCollectors >= 1 && data.maxCollectors <= 500
        && data.maxSubscribers is number && data.maxSubscribers >= 1 && data.maxSubscribers <= 100000
        && isValidId(data.ownerUid)
        && (!('aiPhotoVerificationEnabled' in data) || data.aiPhotoVerificationEnabled is bool)
        && (!('aiPhotoVerificationSealed' in data) || (data.aiPhotoVerificationSealed is string && data.aiPhotoVerificationSealed.size() <= 200))
        && (!('aiPhotoVerificationSealedAt' in data) || data.aiPhotoVerificationSealedAt is timestamp)
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidCollector(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'assignedZones', 'permissions', 'active', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'assignedZones', 'permissions', 'active', 'inviteCode', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 150
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 25
        && data.assignedZones is list && data.assignedZones.size() <= 20
        && (data.assignedZones.size() == 0 || (data.assignedZones[0] is string && data.assignedZones[0].size() <= 100))
        && isValidPermissionsMap(data.permissions)
        && data.active is bool
        && (!('inviteCode' in data) || (data.inviteCode is string && data.inviteCode.size() <= 40))
        && data.createdAt is timestamp;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['meterNumber', 'subscriberName', 'phone', 'previousReading', 'currentReading', 'previousDebtYer', 'zoneStreet', 'sequenceOrder', 'updatedAt'])
        && data.keys().hasOnly(['meterNumber', 'subscriberName', 'phone', 'previousReading', 'currentReading', 'previousDebtYer', 'zoneStreet', 'sequenceOrder', 'assignedCollectorId', 'updatedAt'])
        && data.meterNumber is string && data.meterNumber.size() >= 2 && data.meterNumber.size() <= 40
        && data.subscriberName is string && data.subscriberName.size() >= 2 && data.subscriberName.size() <= 120
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 25
        && data.previousReading is number && data.previousReading >= 0
        && data.currentReading is number && data.currentReading >= data.previousReading
        && data.previousDebtYer is number && data.previousDebtYer >= 0
        && data.zoneStreet is string && data.zoneStreet.size() >= 1 && data.zoneStreet.size() <= 120
        && data.sequenceOrder is number && data.sequenceOrder >= 0 && data.sequenceOrder <= 100000
        && (!('assignedCollectorId' in data) || (data.assignedCollectorId is string && data.assignedCollectorId.size() <= 128))
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidReading(data) {
      return data.keys().hasAll(['subscriberId', 'meterNumber', 'subscriberName', 'previousReading', 'currentReading', 'consumptionKwh', 'kwhPriceYer', 'currentBillYer', 'previousDebtYer', 'totalDueYer', 'photoUrl', 'photoSizeKb', 'collectorUid', 'collectorName', 'recordedAt', 'createdAt'])
        && data.keys().hasOnly(['subscriberId', 'meterNumber', 'subscriberName', 'previousReading', 'currentReading', 'consumptionKwh', 'kwhPriceYer', 'currentBillYer', 'previousDebtYer', 'totalDueYer', 'photoUrl', 'photoSizeKb', 'hasLocalPhoto', 'aiVerificationStatus', 'aiDetectedReading', 'aiConfidence', 'aiVerificationReason', 'collectorUid', 'collectorName', 'recordedAt', 'createdAt'])
        && isValidId(data.subscriberId)
        && data.meterNumber is string && data.meterNumber.size() >= 2 && data.meterNumber.size() <= 40
        && data.subscriberName is string && data.subscriberName.size() >= 2 && data.subscriberName.size() <= 120
        && data.previousReading is number && data.previousReading >= 0
        && data.currentReading is number && data.currentReading >= 0
        && data.consumptionKwh is number && data.consumptionKwh >= 0
        && data.kwhPriceYer is number && data.kwhPriceYer >= 0
        && data.currentBillYer is number && data.currentBillYer >= 0
        && data.previousDebtYer is number && data.previousDebtYer >= 0
        && data.totalDueYer is number && data.totalDueYer >= 0
        && data.photoUrl is string && data.photoUrl.size() == 0
        && data.photoSizeKb is number && data.photoSizeKb >= 0 && data.photoSizeKb <= 200
        && (!('hasLocalPhoto' in data) || data.hasLocalPhoto is bool)
        && (!('aiVerificationStatus' in data) || data.aiVerificationStatus in ['not_checked', 'matched', 'mismatch', 'unreadable', 'pending_offline'])
        && (!('aiDetectedReading' in data) || data.aiDetectedReading is number)
        && (!('aiConfidence' in data) || (data.aiConfidence is number && data.aiConfidence >= 0 && data.aiConfidence <= 1))
        && (!('aiVerificationReason' in data) || (data.aiVerificationReason is string && data.aiVerificationReason.size() <= 300))
        && isValidId(data.collectorUid)
        && data.collectorName is string && data.collectorName.size() >= 1 && data.collectorName.size() <= 120
        && data.recordedAt is timestamp
        && data.createdAt is timestamp;
    }

    function isValidReceipt(data) {
      return data.keys().hasAll(['subscriberId', 'meterNumber', 'subscriberName', 'readingId', 'amountPaidYer', 'remainingBalanceYer', 'collectorUid', 'collectorName', 'paidAt', 'createdAt'])
        && data.keys().hasOnly(['subscriberId', 'meterNumber', 'subscriberName', 'readingId', 'amountPaidYer', 'remainingBalanceYer', 'collectorUid', 'collectorName', 'paidAt', 'createdAt'])
        && isValidId(data.subscriberId)
        && data.meterNumber is string && data.meterNumber.size() >= 2 && data.meterNumber.size() <= 40
        && data.subscriberName is string && data.subscriberName.size() >= 2 && data.subscriberName.size() <= 120
        && isValidId(data.readingId)
        && data.amountPaidYer is number && data.amountPaidYer > 0
        && data.remainingBalanceYer is number && data.remainingBalanceYer >= 0
        && isValidId(data.collectorUid)
        && data.collectorName is string && data.collectorName.size() >= 1 && data.collectorName.size() <= 120
        && data.paidAt is timestamp
        && data.createdAt is timestamp;
    }

    function isValidPortalRecord(data) {
      return data.keys().hasAll(['stationId', 'stationName', 'meterNumber', 'subscriberName', 'zoneStreet', 'previousReading', 'currentReading', 'consumptionKwh', 'currentBillYer', 'previousDebtYer', 'totalDueYer', 'lastReadingPhotoUrl', 'lastPaymentYer', 'updatedAt'])
        && data.keys().hasOnly(['stationId', 'stationName', 'meterNumber', 'subscriberName', 'zoneStreet', 'previousReading', 'currentReading', 'consumptionKwh', 'currentBillYer', 'previousDebtYer', 'totalDueYer', 'lastReadingPhotoUrl', 'lastPaymentYer', 'readingsJson', 'receiptsJson', 'updatedAt'])
        && isValidId(data.stationId)
        && data.stationName is string && data.stationName.size() >= 2 && data.stationName.size() <= 120
        && data.meterNumber is string && data.meterNumber.size() >= 2 && data.meterNumber.size() <= 40
        && data.subscriberName is string && data.subscriberName.size() >= 2 && data.subscriberName.size() <= 120
        && data.zoneStreet is string && data.zoneStreet.size() >= 1 && data.zoneStreet.size() <= 120
        && data.previousReading is number && data.previousReading >= 0
        && data.currentReading is number && data.currentReading >= 0
        && data.consumptionKwh is number && data.consumptionKwh >= 0
        && data.currentBillYer is number && data.currentBillYer >= 0
        && data.previousDebtYer is number && data.previousDebtYer >= 0
        && data.totalDueYer is number && data.totalDueYer >= 0
        && data.lastReadingPhotoUrl is string && data.lastReadingPhotoUrl.size() == 0
        && data.lastPaymentYer is number && data.lastPaymentYer >= 0
        && (!('readingsJson' in data) || (data.readingsJson is string && data.readingsJson.size() <= 150000))
        && (!('receiptsJson' in data) || (data.receiptsJson is string && data.receiptsJson.size() <= 150000))
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidManagerAlert(data) {
      return data.keys().hasAll(['stationId', 'subscriberId', 'meterNumber', 'subscriberName', 'collectorName', 'message', 'severity', 'resolved', 'createdAt'])
        && data.keys().hasOnly(['stationId', 'subscriberId', 'meterNumber', 'subscriberName', 'collectorCode', 'collectorName', 'alertType', 'editedReading', 'aiDetectedReading', 'aiConfidence', 'aiVerificationReason', 'hasLocalPhoto', 'message', 'severity', 'resolved', 'resolvedByCode', 'createdAt'])
        && isValidId(data.stationId)
        && isValidId(data.subscriberId)
        && data.meterNumber is string && data.meterNumber.size() >= 2 && data.meterNumber.size() <= 40
        && data.subscriberName is string && data.subscriberName.size() >= 2 && data.subscriberName.size() <= 120
        && (!('collectorCode' in data) || (data.collectorCode is string && data.collectorCode.size() <= 60))
        && data.collectorName is string && data.collectorName.size() >= 1 && data.collectorName.size() <= 120
        && (!('alertType' in data) || data.alertType in ['photo_mismatch', 'lower_reading', 'high_consumption'])
        && (!('editedReading' in data) || data.editedReading is number)
        && (!('aiDetectedReading' in data) || data.aiDetectedReading is number)
        && (!('aiConfidence' in data) || (data.aiConfidence is number && data.aiConfidence >= 0 && data.aiConfidence <= 1))
        && (!('aiVerificationReason' in data) || (data.aiVerificationReason is string && data.aiVerificationReason.size() <= 300))
        && (!('hasLocalPhoto' in data) || data.hasLocalPhoto is bool)
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 500
        && data.severity in ['warning', 'critical']
        && data.resolved is bool
        && (!('resolvedByCode' in data) || (data.resolvedByCode is string && data.resolvedByCode.size() <= 40))
        && data.createdAt is timestamp;
    }

    function isValidDieselExpense(data) {
      return data.keys().hasAll(['stationId', 'category', 'description', 'amountYer', 'date', 'createdAt'])
        && data.keys().hasOnly(['stationId', 'category', 'description', 'liters', 'amountYer', 'date', 'createdBy', 'createdAt'])
        && isValidId(data.stationId)
        && data.category in ['diesel', 'oil', 'maintenance', 'salary', 'other']
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 240
        && (!('liters' in data) || (data.liters is number && data.liters >= 0))
        && data.amountYer is number && data.amountYer >= 0
        && data.date is string && data.date.size() >= 4 && data.date.size() <= 40
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 120))
        && data.createdAt is timestamp;
    }

    function isValidCollectorLocation(data) {
      return data.keys().hasAll(['collectorCode', 'collectorName', 'lat', 'lng', 'updatedAt'])
        && data.keys().hasOnly(['collectorCode', 'collectorName', 'lat', 'lng', 'accuracyMeters', 'updatedAt'])
        && isValidId(data.collectorCode)
        && data.collectorName is string && data.collectorName.size() >= 1 && data.collectorName.size() <= 120
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (!('accuracyMeters' in data) || (data.accuracyMeters is number && data.accuracyMeters >= 0))
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if false;
      allow create: if isValidId(uid) && isAdmin() && isValidAdminDoc(incoming());
      allow update, delete: if isValidId(uid) && isAdmin();
    }

    // Activation codes: Developer Admin reads & writes all; Manager/Collector reads ONLY their exact code document
    match /codes/{code} {
      allow get: if isAdmin() || isValidCode(code);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidCode(code) && isValidAccessCodeDoc(incoming())
        && incoming().code == code;
      allow delete: if isAdmin() && isValidCode(code);
    }

    // Developer Admin Cloud Vault: ONLY Developer Admin reads and writes
    match /adminVault/{docId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(docId) && (
        (docId == 'meta' && isValidAdminVaultMeta(incoming())) ||
        (docId.matches('^station_[a-zA-Z0-9_\\-]+_p[0-9]+$') && isValidAdminVaultPart(incoming()))
      );
      allow delete: if isAdmin() && isValidId(docId);
    }

    // Hashed station recovery cache for Managers & Collectors across devices (SHA-256 keyed, Admin writes only)
    match /staffVault/{accessHash} {
      allow get: if isAdmin() || isValidId(accessHash);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(accessHash) && isValidStaffVault(incoming());
      allow delete: if isAdmin() && isValidId(accessHash);
    }

    // Super Admin issues isolated station licenses; managers redeem unused codes atomically
    match /licenses/{licenseCode} {
      allow get: if isValidCode(licenseCode) && isSignedIn();
      allow list: if isAdmin();
      allow create: if isValidCode(licenseCode) && isAdmin() && isValidLicense(incoming())
        && incoming().code == licenseCode
        && incoming().createdAt == request.time;
      allow update: if isValidCode(licenseCode) && isSignedIn() && isValidLicense(incoming())
        && incoming().code == existing().code
        && incoming().stationId == existing().stationId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            existing().status == 'unused'
            && incoming().status == 'active'
            && incoming().activatedByUid == request.auth.uid
            && incoming().activatedByEmail == request.auth.token.email
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'activatedByUid', 'activatedByEmail', 'activatedAt', 'updatedAt'])
          )
        );
      allow delete: if isValidCode(licenseCode) && isAdmin();
    }

    // Station Managers issue collector activation codes; deletion is Developer Admin only
    match /collectorInvites/{inviteCode} {
      allow get: if isValidCode(inviteCode) && isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidCode(inviteCode) && isSignedIn() && isValidCollectorInvite(incoming())
        && incoming().inviteCode == inviteCode
        && incoming().status == 'unused'
        && incoming().createdAt == request.time
        && (isAdmin() || (isStationOwner(incoming().stationId) && isStationActive(incoming().stationId) && incoming().ownerUid == request.auth.uid));
      allow update: if isValidCode(inviteCode) && isSignedIn() && isValidCollectorInvite(incoming())
        && incoming().inviteCode == existing().inviteCode
        && incoming().stationId == existing().stationId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          isStationOwner(existing().stationId) ||
          (
            existing().status == 'unused'
            && incoming().status == 'claimed'
            && incoming().claimedByUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedByUid', 'claimedAt'])
          )
        );
      allow delete: if isValidCode(inviteCode) && isAdmin();
    }

    // Direct binding of user UID -> isolated station & role
    match /userRoles/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(uid) && isSignedIn() && isValidUserRole(incoming())
        && (
          isAdmin() ||
          (
            request.auth.uid == uid
            && (
              (
                incoming().role == 'manager'
                && isValidCode(incoming().codeUsed)
                && getAfter(/databases/$(database)/documents/licenses/$(incoming().codeUsed)).data.activatedByUid == request.auth.uid
                && getAfter(/databases/$(database)/documents/licenses/$(incoming().codeUsed)).data.stationId == incoming().stationId
              ) ||
              (
                incoming().role == 'collector'
                && isValidCode(incoming().codeUsed)
                && getAfter(/databases/$(database)/documents/collectorInvites/$(incoming().codeUsed)).data.claimedByUid == request.auth.uid
                && getAfter(/databases/$(database)/documents/collectorInvites/$(incoming().codeUsed)).data.stationId == incoming().stationId
              )
            )
          )
        );
      allow delete: if isValidId(uid) && isAdmin();
    }

    // Isolated Station Tenant Documents
    match /stations/{stationId} {
      allow get: if isValidId(stationId) && (
        isAdmin() ||
        (isSignedIn() && (existing().ownerUid == request.auth.uid || isStationCollector(stationId))) ||
        isActiveCodeForStation(existing().licenseCode, stationId)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(stationId) && isSignedIn() && isValidStation(incoming())
        && (
          isAdmin() ||
          (
            incoming().ownerUid == request.auth.uid
            && incoming().licenseStatus == 'active'
            && !('aiPhotoVerificationEnabled' in incoming())
            && !('aiPhotoVerificationSealed' in incoming())
            && !('aiPhotoVerificationSealedAt' in incoming())
            && exists(/databases/$(database)/documents/licenses/$(incoming().licenseCode))
            && get(/databases/$(database)/documents/licenses/$(incoming().licenseCode)).data.stationId == stationId
            && get(/databases/$(database)/documents/licenses/$(incoming().licenseCode)).data.status == 'unused'
          )
        );
      allow update: if isValidId(stationId) && isValidStation(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().licenseCode == existing().licenseCode
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['stationName', 'licenseStatus', 'maxCollectors', 'maxSubscribers', 'aiPhotoVerificationEnabled', 'aiPhotoVerificationSealed', 'aiPhotoVerificationSealedAt', 'updatedAt'])) ||
          ((isSignedIn() && existing().ownerUid == request.auth.uid && existing().licenseStatus == 'active') && incoming().diff(existing()).affectedKeys().hasOnly(['stationName', 'kwhPriceYer', 'minimumFeeYer', 'mainGeneratorKwh', 'zoneGeneratorKwh', 'updatedAt'])) ||
          (isActiveManagerCodeForStation(existing().licenseCode, stationId) && existing().licenseStatus == 'active' && incoming().diff(existing()).affectedKeys().hasOnly(['stationName', 'kwhPriceYer', 'minimumFeeYer', 'mainGeneratorKwh', 'zoneGeneratorKwh', 'updatedAt']))
        );
      allow delete: if isValidId(stationId) && isAdmin();

      match /collectors/{collectorId} {
        allow get: if isValidId(collectorId) && (isAdmin() || isStationOwner(stationId) || (isSignedIn() && request.auth.uid == collectorId));
        allow list: if isAdmin() || isStationOwner(stationId);
        allow create: if isValidId(collectorId) && isSignedIn() && isValidCollector(incoming())
          && incoming().createdAt == request.time
          && (
            isAdmin() ||
            (isStationOwner(stationId) && isStationActive(stationId)) ||
            (
              request.auth.uid == collectorId
              && isStationActive(stationId)
              && 'inviteCode' in incoming()
              && isValidCode(incoming().inviteCode)
              && exists(/databases/$(database)/documents/collectorInvites/$(incoming().inviteCode))
              && get(/databases/$(database)/documents/collectorInvites/$(incoming().inviteCode)).data.stationId == stationId
              && get(/databases/$(database)/documents/collectorInvites/$(incoming().inviteCode)).data.status == 'unused'
            )
          );
        allow update: if isValidId(collectorId) && (isAdmin() || isStationOwner(stationId)) && isValidCollector(incoming())
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'assignedZones', 'permissions', 'active']);
        allow delete: if isValidId(collectorId) && isAdmin();
      }

      match /subscribers/{subscriberId} {
        allow get: if isValidId(subscriberId) && (isAdmin() || isStationStaff(stationId) || (isValidId(stationId) && resource.data.meterNumber is string));
        allow list: if isAdmin() || isStationStaff(stationId) || (isValidId(stationId) && resource.data.meterNumber is string);
        allow create: if isValidId(subscriberId) && isStationActive(stationId) && (isAdmin() || isStationOwner(stationId)) && isValidSubscriber(incoming());
        allow update: if isValidId(subscriberId) && isStationActive(stationId) && isStationStaff(stationId) && isValidSubscriber(incoming())
          && (
            (isAdmin() || isStationOwner(stationId)) && incoming().diff(existing()).affectedKeys().hasOnly(['meterNumber', 'subscriberName', 'phone', 'previousReading', 'currentReading', 'previousDebtYer', 'zoneStreet', 'sequenceOrder', 'assignedCollectorId', 'updatedAt']) ||
            (collectorHasPermission(stationId, 'canRecordReadings') && incoming().diff(existing()).affectedKeys().hasOnly(['previousReading', 'currentReading', 'previousDebtYer', 'updatedAt'])) ||
            (collectorHasPermission(stationId, 'canCollectCash') && incoming().diff(existing()).affectedKeys().hasOnly(['previousDebtYer', 'updatedAt']))
          );
        allow delete: if isValidId(subscriberId) && isAdmin();
      }

      match /readings/{readingId} {
        allow get: if isValidId(readingId) && (isAdmin() || isStationStaff(stationId) || (isValidId(stationId) && resource.data.meterNumber is string));
        allow list: if isAdmin() || isStationStaff(stationId) || (isValidId(stationId) && resource.data.meterNumber is string);
        allow create: if isValidId(readingId) && isValidId(stationId) && isValidReading(incoming())
          && incoming().createdAt == request.time
          && (
            isAdmin() ||
            isStationStaff(stationId) ||
            isActiveCodeForStation(incoming().collectorUid, stationId)
          );
        allow update: if isValidId(readingId) && isStationActive(stationId) && (isAdmin() || isStationOwner(stationId)) && isValidReading(incoming())
          && incoming().createdAt == existing().createdAt
          && incoming().subscriberId == existing().subscriberId
          && incoming().diff(existing()).affectedKeys().hasOnly(['currentReading', 'consumptionKwh', 'currentBillYer', 'totalDueYer', 'photoUrl', 'photoSizeKb']);
        allow delete: if isValidId(readingId) && isAdmin();
      }

      match /receipts/{receiptId} {
        allow get: if isValidId(receiptId) && (isAdmin() || isStationStaff(stationId) || (isValidId(stationId) && resource.data.meterNumber is string));
        allow list: if isAdmin() || isStationStaff(stationId) || (isValidId(stationId) && resource.data.meterNumber is string);
        allow create: if isValidId(receiptId) && isValidId(stationId) && isValidReceipt(incoming())
          && incoming().createdAt == request.time
          && (
            isAdmin() ||
            isStationStaff(stationId) ||
            isActiveCodeForStation(incoming().collectorUid, stationId)
          );
        allow update: if isValidId(receiptId) && isStationActive(stationId) && (isAdmin() || isStationOwner(stationId)) && isValidReceipt(incoming())
          && incoming().createdAt == existing().createdAt
          && incoming().subscriberId == existing().subscriberId
          && incoming().diff(existing()).affectedKeys().hasOnly(['amountPaidYer', 'remainingBalanceYer']);
        allow delete: if isValidId(receiptId) && isAdmin();
      }

      match /alerts/{alertId} {
        allow get: if isValidId(alertId) && (isAdmin() || isStationStaff(stationId) || (isValidId(stationId) && resource.data.meterNumber is string));
        allow list: if isAdmin() || isStationStaff(stationId) || (isValidId(stationId) && resource.data.meterNumber is string);
        allow create: if isValidId(alertId) && isValidId(stationId) && isValidManagerAlert(incoming())
          && incoming().stationId == stationId
          && incoming().createdAt == request.time
          && (
            isAdmin() ||
            isStationStaff(stationId) ||
            ('collectorCode' in incoming() && isActiveCodeForStation(incoming().collectorCode, stationId))
          );
        allow update: if isValidId(alertId) && isValidId(stationId) && isValidManagerAlert(incoming())
          && incoming().createdAt == existing().createdAt
          && incoming().stationId == existing().stationId
          && (
            (isAdmin() || isStationOwner(stationId)) && incoming().diff(existing()).affectedKeys().hasOnly(['resolved']) ||
            ('resolvedByCode' in incoming() && isActiveManagerCodeForStation(incoming().resolvedByCode, stationId) && incoming().diff(existing()).affectedKeys().hasOnly(['resolved', 'resolvedByCode']))
          );
        allow delete: if isValidId(alertId) && isAdmin();
      }

      match /expenses/{expenseId} {
        allow get: if isValidId(expenseId) && (isAdmin() || isStationOwner(stationId));
        allow list: if isAdmin() || isStationOwner(stationId);
        allow create: if isValidId(expenseId) && isStationActive(stationId) && (isAdmin() || isStationOwner(stationId)) && isValidDieselExpense(incoming())
          && incoming().stationId == stationId
          && incoming().createdAt == request.time;
        allow update: if isValidId(expenseId) && isStationActive(stationId) && (isAdmin() || isStationOwner(stationId)) && isValidDieselExpense(incoming())
          && incoming().createdAt == existing().createdAt
          && incoming().stationId == existing().stationId;
        allow delete: if isValidId(expenseId) && isAdmin();
      }

      match /collectorLocations/{collectorCode} {
        allow get: if isValidId(collectorCode) && (isAdmin() || isStationStaff(stationId) || (isValidId(stationId) && resource.data.collectorCode is string));
        allow list: if isAdmin() || isStationStaff(stationId) || (isValidId(stationId) && resource.data.collectorCode is string);
        allow create, update: if isValidId(collectorCode) && isValidId(stationId) && isValidCollectorLocation(incoming())
          && incoming().collectorCode == collectorCode
          && (
            isAdmin() ||
            isStationStaff(stationId) ||
            isActiveCodeForStation(collectorCode, stationId)
          );
        allow delete: if isValidId(collectorCode) && isAdmin();
      }
    }

    match /subscriberPortals/{lookupHash} {
      allow get: if isAdmin() || isValidId(lookupHash);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(lookupHash) && isValidPortalRecord(incoming());
      allow delete: if isAdmin() && isValidId(lookupHash);
    }
  }
}
